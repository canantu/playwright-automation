{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "Playwright automation project",
  "main": "index.js",
  "author": "Canan Tunc",
  "license": "ISC",
  "scripts": {
    "tests": "npx playwright test",
    "tests:headed": "npx playwright test --headed",
    "test:specific": "npx playwright test --grep example.spec.js",
    "test:tag": "npx playwright test --grep @env-test",
    "test:tag:headed": "npx playwright test --grep @test1 --headed",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "22.20.1",
    "dotenv": "^17.4.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0"
  }
}
